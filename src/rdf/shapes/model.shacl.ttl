# ==============================================================================
# PREFIXES
# ==============================================================================

@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix dcmitype:        <http://purl.org/dc/dcmitype/> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix prov:            <http://www.w3.org/ns/prov#> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix service:         <http://purl.org/ontology/service#> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix shape:           <https://agriculture.ld.admin.ch/system-map/shapes/> .
@prefix systemmap:       <https://agriculture.ld.admin.ch/system-map/> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# DATA MODEL
# ==============================================================================

shape: a owl:Ontology ;
    rdfs:label "Datenmodell der Systemlandkarte"@de,
        "System map data model"@en,
        "Modèle de données de la carte des systèmes"@fr,
        "Modello di dati della mappa dei sistemi"@it ;
    rdfs:comment "Dieses SHACL-Datenmodell beschreibt und validiert die IT-Systeme, Daten, Services und Organisationen der Systemlandkarte."@de,
        "This SHACL data model describes and validates the IT systems, data, services and organizations of the system map."@en,
        "Ce modèle de données SHACL décrit et valide les systèmes informatiques, les données, les services et les organisations de la carte des systèmes."@fr,
        "Questo modello di dati SHACL descrive e convalida i sistemi IT, i dati, i servizi e le organizzazioni della mappa dei sistemi."@it ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "systemmap" ;
        sh:namespace "https://agriculture.ld.admin.ch/system-map/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "dcterms" ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
    ] .

shape:OrganizationShape a sh:NodeShape ;
    rdfs:label "Organisation"@de,
            "Organization"@en,
            "Organisation"@fr,
            "Organizzazione"@it ;
    rdfs:comment "Organisationen der Verwaltung und der Privatwirtschaft, die IT-Systeme betreiben, besitzen oder entwickeln."@de,
            "Public and private organizations that operate, own or develop IT systems."@en,
            "Organisations publiques et privées qui exploitent, possèdent ou développent des systèmes informatiques."@fr,
            "Organizzazioni pubbliche e private che gestiscono, possiedono o sviluppano sistemi IT."@it ;
    sh:targetClass schema:Organization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:minCount 1 ;
        sh:message "Organisation: «Name» ist eine Pflichtangabe. Organisation: «Name» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "Organization: 'Name' is required. Organization: 'Name' needs a language tag and at most one value per language."@en,
            "Organisation: « Nom » est obligatoire. Organisation: « Nom » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Organizzazione: «Nome» è obbligatorio. Organizzazione: «Nome» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 2 ;
        sh:name "Beschreibung"@de,
            "Description"@en,
            "Description"@fr,
            "Descrizione"@it ;
        sh:path schema:description ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "Organisation: «Beschreibung» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "Organization: 'Description' needs a language tag and at most one value per language."@en,
            "Organisation: « Description » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Organizzazione: «Descrizione» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 3 ;
        sh:name "Abkürzung"@de,
            "Abbreviation"@en,
            "Abréviation"@fr,
            "Abbreviazione"@it ;
        sh:path systemmap:abbreviation ;
        sh:nodeKind sh:Literal ;
        sh:message "Organisation: «Abkürzung» muss ein Text sein."@de,
            "Organization: 'Abbreviation' must be a literal."@en,
            "Organisation: « Abréviation » doit être un texte."@fr,
            "Organizzazione: «Abbreviazione» deve essere un testo."@it ;
    ] ;
    sh:property [
        sh:order 4 ;
        sh:name "hat Landingpage"@de,
            "has landing page"@en,
            "a page d'accueil"@fr,
            "ha pagina di destinazione"@it ;
        sh:path schema:url ;
        sh:nodeKind sh:IRI ;
        sh:message "Organisation: «hat Landingpage» muss eine IRI sein."@de,
            "Organization: 'has landing page' must be an IRI."@en,
            "Organisation: « a page d'accueil » doit être une IRI."@fr,
            "Organizzazione: «ha pagina di destinazione» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 5 ;
        sh:name "Registereintrag"@de,
            "Register entry"@en,
            "Entrée de registre"@fr,
            "Voce di registro"@it ;
        sh:path schema:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:message "Organisation: «Registereintrag» muss eine IRI sein."@de,
            "Organization: 'Register entry' must be an IRI."@en,
            "Organisation: « Entrée de registre » doit être une IRI."@fr,
            "Organizzazione: «Voce di registro» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 6 ;
        sh:name "gehört zu"@de,
            "belongs to"@en,
            "fait partie de"@fr,
            "fa parte di"@it ;
        sh:path schema:parentOrganization ;
        sh:class schema:Organization ;
        sh:message "Organisation: «gehört zu» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: 'belongs to' must point to a Organization."@en,
            "Organisation: « fait partie de » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «fa parte di» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 7 ;
        sh:name "beinhaltet Suborganisation"@de,
            "contains suborganization"@en,
            "contient une sous-organisation"@fr,
            "contiene un'organizzazione subordinata"@it ;
        sh:path schema:subOrganization ;
        sh:class schema:Organization ;
        sh:message "Organisation: «beinhaltet Suborganisation» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: 'contains suborganization' must point to a Organization."@en,
            "Organisation: « contient une sous-organisation » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «contiene un'organizzazione subordinata» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 8 ;
        sh:name "Mitglied von"@de,
            "member of"@en,
            "membre de"@fr,
            "membro di"@it ;
        sh:path schema:memberOf ;
        sh:class schema:Organization ;
        sh:message "Organisation: «Mitglied von» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: 'member of' must point to a Organization."@en,
            "Organisation: « membre de » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «membro di» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 9 ;
        sh:name "hat Mitglied"@de,
            "has member"@en,
            "a des membres"@fr,
            "ha membri"@it ;
        sh:path schema:member ;
        sh:class schema:Organization ;
        sh:message "Organisation: «hat Mitglied» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: 'has member' must point to a Organization."@en,
            "Organisation: « a des membres » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «ha membri» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 10 ;
        sh:name "besitzt (teilweise)"@de,
            "(partially) owns"@en,
            "possède (partiellement)"@fr,
            "possiede (parzialmente)"@it ;
        sh:path systemmap:owns ;
        sh:class schema:Organization ;
        sh:message "Organisation: «besitzt (teilweise)» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: '(partially) owns' must point to a Organization."@en,
            "Organisation: « possède (partiellement) » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «possiede (parzialmente)» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 11 ;
        sh:name "ist (teilweise) in Besitz von"@de,
            "is (partially) owned by"@en,
            "est (partiellement) détenu par"@fr,
            "è (parzialmente) di proprietà di"@it ;
        sh:path systemmap:ownedBy ;
        sh:class schema:Organization ;
        sh:message "Organisation: «ist (teilweise) in Besitz von» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "Organization: 'is (partially) owned by' must point to a Organization."@en,
            "Organisation: « est (partiellement) détenu par » doit renvoyer à un objet de type Organisation."@fr,
            "Organizzazione: «è (parzialmente) di proprietà di» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 12 ;
        sh:name "betreibt"@de,
            "operates"@en,
            "exploite"@fr,
            "gestisce"@it ;
        sh:path systemmap:operates ;
        sh:class schema:SoftwareApplication ;
        sh:message "Organisation: «betreibt» muss auf ein Objekt vom Typ IT-System verweisen."@de,
            "Organization: 'operates' must point to a IT system."@en,
            "Organisation: « exploite » doit renvoyer à un objet de type Système informatique."@fr,
            "Organizzazione: «gestisce» deve riferirsi a un oggetto di tipo Sistema IT."@it ;
    ] ;
    sh:property [
        sh:order 13 ;
        sh:name "entwickelt"@de,
            "develops"@en,
            "développe"@fr,
            "sviluppa"@it ;
        sh:path systemmap:develops ;
        sh:class schema:SoftwareApplication ;
        sh:message "Organisation: «entwickelt» muss auf ein Objekt vom Typ IT-System verweisen."@de,
            "Organization: 'develops' must point to a IT system."@en,
            "Organisation: « développe » doit renvoyer à un objet de type Système informatique."@fr,
            "Organizzazione: «sviluppa» deve riferirsi a un oggetto di tipo Sistema IT."@it ;
    ] ;
    sh:property [
        sh:order 14 ;
        sh:name "hat Zugriff auf"@de,
            "has access to"@en,
            "a accès à"@fr,
            "ha accesso a"@it ;
        sh:path systemmap:access ;
        sh:nodeKind sh:IRI ;
        sh:message "Organisation: «hat Zugriff auf» muss eine IRI sein."@de,
            "Organization: 'has access to' must be an IRI."@en,
            "Organisation: « a accès à » doit être une IRI."@fr,
            "Organizzazione: «ha accesso a» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 15 ;
        sh:name "hat Rechtsgrundlage"@de,
            "has legal basis"@en,
            "a une base légale"@fr,
            "ha una base legale"@it ;
        sh:path systemmap:hasLegalBasis ;
        sh:class schema:Legislation ;
        sh:message "Organisation: «hat Rechtsgrundlage» muss auf ein Objekt vom Typ Gesetzgebung verweisen."@de,
            "Organization: 'has legal basis' must point to a Legislation."@en,
            "Organisation: « a une base légale » doit renvoyer à un objet de type Législation."@fr,
            "Organizzazione: «ha una base legale» deve riferirsi a un oggetto di tipo Legislazione."@it ;
    ] .

shape:SoftwareApplicationShape a sh:NodeShape ;
    rdfs:label "IT-System"@de,
            "IT system"@en,
            "Système informatique"@fr,
            "Sistema IT"@it ;
    rdfs:comment "IT-Systeme, die Daten des Agrar- und Ernährungssektors verarbeiten. Jedes IT-System wird direkt oder über ein übergeordnetes System von einer Organisation betrieben."@de,
            "IT systems processing data of the agri-food sector. Every IT system is operated by an organization, directly or via a parent system."@en,
            "Systèmes informatiques traitant des données du secteur agroalimentaire. Chaque système informatique est exploité par une organisation, directement ou via un système parent."@fr,
            "Sistemi IT che trattano dati del settore agroalimentare. Ogni sistema IT è gestito da un'organizzazione, direttamente o tramite un sistema padre."@it ;
    sh:targetClass schema:SoftwareApplication ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:minCount 1 ;
        sh:message "IT-System: «Name» ist eine Pflichtangabe. IT-System: «Name» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "IT system: 'Name' is required. IT system: 'Name' needs a language tag and at most one value per language."@en,
            "Système informatique: « Nom » est obligatoire. Système informatique: « Nom » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Sistema IT: «Nome» è obbligatorio. Sistema IT: «Nome» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 2 ;
        sh:name "Beschreibung"@de,
            "Description"@en,
            "Description"@fr,
            "Descrizione"@it ;
        sh:path schema:description ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:minCount 1 ;
        sh:message "IT-System: «Beschreibung» ist eine Pflichtangabe. IT-System: «Beschreibung» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "IT system: 'Description' is required. IT system: 'Description' needs a language tag and at most one value per language."@en,
            "Système informatique: « Description » est obligatoire. Système informatique: « Description » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Sistema IT: «Descrizione» è obbligatorio. Sistema IT: «Descrizione» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 3 ;
        sh:name "Abkürzung"@de,
            "Abbreviation"@en,
            "Abréviation"@fr,
            "Abbreviazione"@it ;
        sh:path systemmap:abbreviation ;
        sh:nodeKind sh:Literal ;
        sh:message "IT-System: «Abkürzung» muss ein Text sein."@de,
            "IT system: 'Abbreviation' must be a literal."@en,
            "Système informatique: « Abréviation » doit être un texte."@fr,
            "Sistema IT: «Abbreviazione» deve essere un testo."@it ;
    ] ;
    sh:property [
        sh:order 4 ;
        sh:name "Alternativer Name"@de,
            "Alternative name"@en,
            "Autre nom"@fr,
            "Nome alternativo"@it ;
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        sh:message "IT-System: «Alternativer Name» braucht ein Sprach-Tag."@de,
            "IT system: 'Alternative name' needs a language tag."@en,
            "Système informatique: « Autre nom » nécessite une balise de langue."@fr,
            "Sistema IT: «Nome alternativo» richiede un tag di lingua."@it ;
    ] ;
    sh:property [
        sh:order 5 ;
        sh:name "hat Landingpage"@de,
            "has landing page"@en,
            "a page d'accueil"@fr,
            "ha pagina di destinazione"@it ;
        sh:path schema:url ;
        sh:nodeKind sh:IRI ;
        sh:message "IT-System: «hat Landingpage» muss eine IRI sein."@de,
            "IT system: 'has landing page' must be an IRI."@en,
            "Système informatique: « a page d'accueil » doit être une IRI."@fr,
            "Sistema IT: «ha pagina di destinazione» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 6 ;
        sh:name "Siehe auch"@de,
            "See also"@en,
            "Voir aussi"@fr,
            "Vedi anche"@it ;
        sh:path rdfs:seeAlso ;
        sh:nodeKind sh:IRI ;
        sh:message "IT-System: «Siehe auch» muss eine IRI sein."@de,
            "IT system: 'See also' must be an IRI."@en,
            "Système informatique: « Voir aussi » doit être une IRI."@fr,
            "Sistema IT: «Vedi anche» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 7 ;
        sh:name "wird betrieben von"@de,
            "is operated by"@en,
            "est exploité par"@fr,
            "è gestito da"@it ;
        sh:path systemmap:operatedBy ;
        sh:class schema:Organization ;
        sh:message "IT-System: «wird betrieben von» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "IT system: 'is operated by' must point to a Organization."@en,
            "Système informatique: « est exploité par » doit renvoyer à un objet de type Organisation."@fr,
            "Sistema IT: «è gestito da» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 8 ;
        sh:name "entwickelt von"@de,
            "developed by"@en,
            "développé par"@fr,
            "sviluppato da"@it ;
        sh:path systemmap:developedBy ;
        sh:class schema:Organization ;
        sh:message "IT-System: «entwickelt von» muss auf ein Objekt vom Typ Organisation verweisen."@de,
            "IT system: 'developed by' must point to a Organization."@en,
            "Système informatique: « développé par » doit renvoyer à un objet de type Organisation."@fr,
            "Sistema IT: «sviluppato da» deve riferirsi a un oggetto di tipo Organizzazione."@it ;
    ] ;
    sh:property [
        sh:order 9 ;
        sh:name "beinhaltet"@de,
            "contains"@en,
            "contient"@fr,
            "contiene"@it ;
        sh:path systemmap:contains ;
        sh:class dcat:Dataset ;
        sh:message "IT-System: «beinhaltet» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "IT system: 'contains' must point to a Dataset."@en,
            "Système informatique: « contient » doit renvoyer à un objet de type Jeu de données."@fr,
            "Sistema IT: «contiene» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 10 ;
        sh:name "nutzt IT-Service"@de,
            "uses IT service"@en,
            "utilise un service informatique"@fr,
            "utilizza un servizio IT"@it ;
        sh:path service:consumes ;
        sh:class service:Service ;
        sh:message "IT-System: «nutzt IT-Service» muss auf ein Objekt vom Typ IT-Service verweisen."@de,
            "IT system: 'uses IT service' must point to a IT service."@en,
            "Système informatique: « utilise un service informatique » doit renvoyer à un objet de type Service informatique."@fr,
            "Sistema IT: «utilizza un servizio IT» deve riferirsi a un oggetto di tipo Servizio IT."@it ;
    ] ;
    sh:property [
        sh:order 11 ;
        sh:name "bietet Service an"@de,
            "provides service"@en,
            "fournit un service"@fr,
            "fornisce un servizio"@it ;
        sh:path service:provides ;
        sh:class service:Service ;
        sh:message "IT-System: «bietet Service an» muss auf ein Objekt vom Typ IT-Service verweisen."@de,
            "IT system: 'provides service' must point to a IT service."@en,
            "Système informatique: « fournit un service » doit renvoyer à un objet de type Service informatique."@fr,
            "Sistema IT: «fornisce un servizio» deve riferirsi a un oggetto di tipo Servizio IT."@it ;
    ] ;
    sh:property [
        sh:order 12 ;
        sh:name "ist Teil von"@de,
            "is part of"@en,
            "fait partie de"@fr,
            "fa parte di"@it ;
        sh:path dcterms:isPartOf ;
        sh:class schema:SoftwareApplication ;
        sh:message "IT-System: «ist Teil von» muss auf ein Objekt vom Typ IT-System verweisen."@de,
            "IT system: 'is part of' must point to a IT system."@en,
            "Système informatique: « fait partie de » doit renvoyer à un objet de type Système informatique."@fr,
            "Sistema IT: «fa parte di» deve riferirsi a un oggetto di tipo Sistema IT."@it ;
    ] ;
    sh:property [
        sh:order 13 ;
        sh:name "hat Teil"@de,
            "has part"@en,
            "a pour partie"@fr,
            "ha parte"@it ;
        sh:path dcterms:hasPart ;
        sh:class schema:SoftwareApplication ;
        sh:message "IT-System: «hat Teil» muss auf ein Objekt vom Typ IT-System verweisen."@de,
            "IT system: 'has part' must point to a IT system."@en,
            "Système informatique: « a pour partie » doit renvoyer à un objet de type Système informatique."@fr,
            "Sistema IT: «ha parte» deve riferirsi a un oggetto di tipo Sistema IT."@it ;
    ] ;
    sh:property [
        sh:order 14 ;
        sh:name "hat Rechtsgrundlage"@de,
            "has legal basis"@en,
            "a une base légale"@fr,
            "ha una base legale"@it ;
        sh:path systemmap:hasLegalBasis ;
        sh:class schema:Legislation ;
        sh:message "IT-System: «hat Rechtsgrundlage» muss auf ein Objekt vom Typ Gesetzgebung verweisen."@de,
            "IT system: 'has legal basis' must point to a Legislation."@en,
            "Système informatique: « a une base légale » doit renvoyer à un objet de type Législation."@fr,
            "Sistema IT: «ha una base legale» deve riferirsi a un oggetto di tipo Legislazione."@it ;
    ] ;
    sh:property [
        sh:order 15 ;
        sh:name "Schlagwort"@de,
            "Keyword"@en,
            "Mot-clé"@fr,
            "Parola chiave"@it ;
        sh:path schema:keywords ;
        sh:class schema:DefinedTerm ;
        sh:message "IT-System: «Schlagwort» muss auf ein Objekt vom Typ Schlagwort verweisen."@de,
            "IT system: 'Keyword' must point to a Keyword."@en,
            "Système informatique: « Mot-clé » doit renvoyer à un objet de type Mot-clé."@fr,
            "Sistema IT: «Parola chiave» deve riferirsi a un oggetto di tipo Parola chiave."@it ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shape: ;
        sh:message "IT-System: Jedes IT-System muss direkt oder über ein übergeordnetes System von einer Organisation betrieben werden."@de,
            "IT system: Every IT system must be operated by an organization, directly or via a parent system."@en,
            "Système informatique : chaque système informatique doit être exploité par une organisation, directement ou via un système parent."@fr,
            "Sistema IT: ogni sistema IT deve essere gestito da un'organizzazione, direttamente o tramite un sistema padre."@it ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dcterms:isPartOf*/systemmap:operatedBy ?organization .
                    ?organization a schema:Organization .
                }
            }
        """ ;
    ] .

shape:DatasetShape a sh:NodeShape ;
    rdfs:label "Datensatz"@de,
            "Dataset"@en,
            "Jeu de données"@fr,
            "Dataset"@it ;
    rdfs:comment "Informationseinheiten, die in IT-Systemen enthalten sind. Jeder Datensatz liegt direkt oder über einen übergeordneten Datensatz in einem IT-System."@de,
            "Information units contained in IT systems. Every dataset is contained in an IT system, directly or via a parent dataset."@en,
            "Unités d'information contenues dans des systèmes informatiques. Chaque jeu de données est contenu dans un système informatique, directement ou via un jeu de données parent."@fr,
            "Unità di informazione contenute nei sistemi IT. Ogni dataset è contenuto in un sistema IT, direttamente o tramite un dataset padre."@it ;
    sh:targetClass dcat:Dataset ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:minCount 1 ;
        sh:message "Datensatz: «Name» ist eine Pflichtangabe. Datensatz: «Name» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "Dataset: 'Name' is required. Dataset: 'Name' needs a language tag and at most one value per language."@en,
            "Jeu de données: « Nom » est obligatoire. Jeu de données: « Nom » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Dataset: «Nome» è obbligatorio. Dataset: «Nome» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 2 ;
        sh:name "Beschreibung"@de,
            "Description"@en,
            "Description"@fr,
            "Descrizione"@it ;
        sh:path schema:description ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
        sh:message "Datensatz: «Beschreibung» braucht ein Sprach-Tag und höchstens einen Wert pro Sprache."@de,
            "Dataset: 'Description' needs a language tag and at most one value per language."@en,
            "Jeu de données: « Description » nécessite une balise de langue et au plus une valeur par langue."@fr,
            "Dataset: «Descrizione» richiede un tag di lingua e al massimo un valore per lingua."@it ;
    ] ;
    sh:property [
        sh:order 3 ;
        sh:name "Abkürzung"@de,
            "Abbreviation"@en,
            "Abréviation"@fr,
            "Abbreviazione"@it ;
        sh:path systemmap:abbreviation ;
        sh:nodeKind sh:Literal ;
        sh:message "Datensatz: «Abkürzung» muss ein Text sein."@de,
            "Dataset: 'Abbreviation' must be a literal."@en,
            "Jeu de données: « Abréviation » doit être un texte."@fr,
            "Dataset: «Abbreviazione» deve essere un testo."@it ;
    ] ;
    sh:property [
        sh:order 4 ;
        sh:name "hat Landingpage"@de,
            "has landing page"@en,
            "a page d'accueil"@fr,
            "ha pagina di destinazione"@it ;
        sh:path schema:url ;
        sh:nodeKind sh:IRI ;
        sh:message "Datensatz: «hat Landingpage» muss eine IRI sein."@de,
            "Dataset: 'has landing page' must be an IRI."@en,
            "Jeu de données: « a page d'accueil » doit être une IRI."@fr,
            "Dataset: «ha pagina di destinazione» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 5 ;
        sh:name "Siehe auch"@de,
            "See also"@en,
            "Voir aussi"@fr,
            "Vedi anche"@it ;
        sh:path rdfs:seeAlso ;
        sh:nodeKind sh:IRI ;
        sh:message "Datensatz: «Siehe auch» muss eine IRI sein."@de,
            "Dataset: 'See also' must be an IRI."@en,
            "Jeu de données: « Voir aussi » doit être une IRI."@fr,
            "Dataset: «Vedi anche» deve essere un IRI."@it ;
    ] ;
    sh:property [
        sh:order 6 ;
        sh:name "Schlagwort"@de,
            "Keyword"@en,
            "Mot-clé"@fr,
            "Parola chiave"@it ;
        sh:path schema:keywords ;
        sh:class schema:DefinedTerm ;
        sh:message "Datensatz: «Schlagwort» muss auf ein Objekt vom Typ Schlagwort verweisen."@de,
            "Dataset: 'Keyword' must point to a Keyword."@en,
            "Jeu de données: « Mot-clé » doit renvoyer à un objet de type Mot-clé."@fr,
            "Dataset: «Parola chiave» deve riferirsi a un oggetto di tipo Parola chiave."@it ;
    ] ;
    sh:property [
        sh:order 7 ;
        sh:name "ist beinhaltet in"@de,
            "is contained in"@en,
            "est contenu dans"@fr,
            "è contenuto in"@it ;
        sh:path systemmap:containedIn ;
        sh:class schema:SoftwareApplication ;
        sh:message "Datensatz: «ist beinhaltet in» muss auf ein Objekt vom Typ IT-System verweisen."@de,
            "Dataset: 'is contained in' must point to a IT system."@en,
            "Jeu de données: « est contenu dans » doit renvoyer à un objet de type Système informatique."@fr,
            "Dataset: «è contenuto in» deve riferirsi a un oggetto di tipo Sistema IT."@it ;
    ] ;
    sh:property [
        sh:order 8 ;
        sh:name "ist Teil von"@de,
            "is part of"@en,
            "fait partie de"@fr,
            "fa parte di"@it ;
        sh:path dcterms:isPartOf ;
        sh:class dcat:Dataset ;
        sh:message "Datensatz: «ist Teil von» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "Dataset: 'is part of' must point to a Dataset."@en,
            "Jeu de données: « fait partie de » doit renvoyer à un objet de type Jeu de données."@fr,
            "Dataset: «fa parte di» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 9 ;
        sh:name "hat Teil"@de,
            "has part"@en,
            "a pour partie"@fr,
            "ha parte"@it ;
        sh:path dcterms:hasPart ;
        sh:class dcat:Dataset ;
        sh:message "Datensatz: «hat Teil» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "Dataset: 'has part' must point to a Dataset."@en,
            "Jeu de données: « a pour partie » doit renvoyer à un objet de type Jeu de données."@fr,
            "Dataset: «ha parte» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 10 ;
        sh:name "hat Masterdaten"@de,
            "has master data"@en,
            "utilise des données de base"@fr,
            "utilizza dati anagrafici"@it ;
        sh:path systemmap:usesMasterData ;
        sh:class dcat:Dataset ;
        sh:message "Datensatz: «hat Masterdaten» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "Dataset: 'has master data' must point to a Dataset."@en,
            "Jeu de données: « utilise des données de base » doit renvoyer à un objet de type Jeu de données."@fr,
            "Dataset: «utilizza dati anagrafici» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 11 ;
        sh:name "wurde abgeleitet von"@de,
            "was derived from"@en,
            "a été dérivé de"@fr,
            "è stato derivato da"@it ;
        sh:path prov:wasDerivedFrom ;
        sh:class dcat:Dataset ;
        sh:message "Datensatz: «wurde abgeleitet von» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "Dataset: 'was derived from' must point to a Dataset."@en,
            "Jeu de données: « a été dérivé de » doit renvoyer à un objet de type Jeu de données."@fr,
            "Dataset: «è stato derivato da» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 12 ;
        sh:name "informiert"@de,
            "informs"@en,
            "informe"@fr,
            "informa"@it ;
        sh:path systemmap:informs ;
        sh:class dcat:Dataset ;
        sh:message "Datensatz: «informiert» muss auf ein Objekt vom Typ Datensatz verweisen."@de,
            "Dataset: 'informs' must point to a Dataset."@en,
            "Jeu de données: « informe » doit renvoyer à un objet de type Jeu de données."@fr,
            "Dataset: «informa» deve riferirsi a un oggetto di tipo Dataset."@it ;
    ] ;
    sh:property [
        sh:order 13 ;
        sh:name "hat Rechtsgrundlage"@de,
            "has legal basis"@en,
            "a une base légale"@fr,
            "ha una base legale"@it ;
        sh:path systemmap:hasLegalBasis ;
        sh:class schema:Legislation ;
        sh:message "Datensatz: «hat Rechtsgrundlage» muss auf ein Objekt vom Typ Gesetzgebung verweisen."@de,
            "Dataset: 'has legal basis' must point to a Legislation."@en,
            "Jeu de données: « a une base légale » doit renvoyer à un objet de type Législation."@fr,
            "Dataset: «ha una base legale» deve riferirsi a un oggetto di tipo Legislazione."@it ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes shape: ;
        sh:message "Datensatz: Jeder Datensatz muss direkt oder über einen übergeordneten Datensatz in einem IT-System enthalten sein."@de,
            "Dataset: Every dataset must be contained in an IT system, directly or via a parent dataset."@en,
            "Jeu de données : chaque jeu de données doit être contenu dans un système informatique, directement ou via un jeu de données parent."@fr,
            "Dataset: ogni dataset deve essere contenuto in un sistema IT, direttamente o tramite un dataset padre."@it ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dcterms:isPartOf*/systemmap:containedIn ?system .
                    ?system a schema:SoftwareApplication .
                }
            }
        """ ;
    ] .

