# ==============================================================================
# GRAPH METADATA
# ==============================================================================
#
# Describes the named graph on LINDAS as a dataset (schema.org, DCAT, VoID),
# so that it can be found on LINDAS and opendata.swiss. The subject is the
# IRI of the named graph (ech.graph in docs/_ech.yml, GRAPH in .env).
#
# The modification date (schema:dateModified, dcterms:modified) is not kept
# here: `make publish` sets it automatically when the content of the graph
# differs from the one currently on LINDAS (src/python/utils/graph_metadata.py).

@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix schema:          <http://schema.org/> .
@prefix vcard:           <http://www.w3.org/2006/vcard/ns#> .
@prefix void:            <http://rdfs.org/ns/void#> .
@prefix org:             <https://register.ld.admin.ch/opendataswiss/org/> .
@prefix frequency:       <https://publications.europa.eu/resource/authority/frequency/> .

<https://lindas.admin.ch/foag/system-map> a void:Dataset,
        schema:Dataset ;
    schema:name
        "Systemlandkarte des Schweizer Agrar- und Ernährungssektors"@de,
        "System map of the Swiss agri-food sector"@en,
        "Carte des systèmes du secteur agroalimentaire suisse"@fr,
        "Mappa dei sistemi del settore agroalimentare svizzero"@it ;
    schema:description
        "Wissensgraph der IT-Systeme des Schweizer Agrar- und Ernährungssektors, der Daten, die sie enthalten, der Services, die sie anbieten und nutzen, sowie der Organisationen, die sie betreiben, besitzen oder entwickeln."@de,
        "Knowledge graph of the IT systems of the Swiss agri-food sector, the data they contain, the services they provide and consume, and the organizations that operate, own or develop them."@en,
        "Graphe de connaissances des systèmes informatiques du secteur agroalimentaire suisse, des données qu'ils contiennent, des services qu'ils fournissent et utilisent, ainsi que des organisations qui les exploitent, les possèdent ou les développent."@fr,
        "Grafo di conoscenza dei sistemi IT del settore agroalimentare svizzero, dei dati che contengono, dei servizi che forniscono e utilizzano e delle organizzazioni che li gestiscono, li possiedono o li sviluppano."@it ;
    schema:creator org:blw-ofag-ufag ;
    schema:publisher org:blw-ofag-ufag ;
    dcat:contactPoint [
        a vcard:Organization ;
        vcard:fn "Bundesamt für Landwirtschaft BLW" ;
        vcard:hasEmail <mailto:agridata.ch@blw.admin.ch>
    ] ;
    dcat:landingPage <https://github.com/blw-ofag-ufag/system-map-backend> ;
    dcterms:language "de", "fr", "it", "en" ;
    dcterms:accrualPeriodicity frequency:IRREG ;
    dcat:keyword "Systemlandkarte"@de, "System map"@en, "Carte des systèmes"@fr, "Mappa dei sistemi"@it,
        "IT-Systeme"@de, "IT systems"@en, "Systèmes informatiques"@fr, "Sistemi IT"@it .
