# IT systems of the system map, with their operating organizations (in German)
PREFIX schema: <http://schema.org/>
PREFIX systemmap: <https://agriculture.ld.admin.ch/system-map/>

SELECT ?system ?operator
FROM <https://lindas.admin.ch/foag/system-map>
WHERE {
  ?s a schema:SoftwareApplication ;
     schema:name ?system ;
     systemmap:operatedBy/schema:name ?operator .
  FILTER(LANG(?system) = "de" && LANG(?operator) = "de")
}
ORDER BY ?system
LIMIT 20
